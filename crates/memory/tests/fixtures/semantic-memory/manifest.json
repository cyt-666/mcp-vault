    {
      "id": "T02",
      "q_refs": ["Q02", "Q15"],
      "coverage_tags": ["ordered_steps", "exception"],
      "question": "Rhea 生产发布达到错误率门槛后应如何回滚？",
      "source_ids": ["S01", "S02", "S03"],
      "caller": {
        "vault_id": "vault-alpha",
        "permissions": ["memory:read", "vault:read"]
      },
      "expected_usable_information": ["先停止增加流量，再将权重设为 0%，确认稳定版本接管并记录故障编号。"],
      "must_preserve_conditions": ["错误率达到或超过 2% 才触发回滚。", "重新开放需要单独决定。"],
      "must_not_infer": ["不能交换回滚步骤顺序。", "不能把重新开放描述为自动步骤。"],
      "expected_status": "available",
      "expected_source_relations": [
        {"kind": "supplements", "source_ids": ["S01", "S03"]}
      ],
      "severity": "critical"
    },
