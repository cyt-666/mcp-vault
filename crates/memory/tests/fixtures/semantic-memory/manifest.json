      "q_refs": ["Q01"],
      "coverage_tags": ["duplicate_sources"],
      "question": "Rhea 的生产发布决定是什么？",
      "source_ids": ["S01", "S02", "S03"],
      "caller": {
        "vault_id": "vault-alpha",
        "permissions": ["memory:read", "vault:read"]
      },
      "expected_usable_information": ["发布决定应只表达一次。", "先放开 5% 流量。", "下一阶段要求错误率低于 2%。"],
      "must_preserve_conditions": ["范围是 Rhea 生产环境。", "测试环境不适用。"],
      "must_not_infer": ["不能把同义来源算成三项独立决定。", "不能把生产策略推广到测试环境。"],
      "expected_status": "available",
      "expected_source_relations": [
        {"kind": "duplicate", "source_ids": ["S01", "S02"]},
        {"kind": "supplements", "source_ids": ["S02", "S03"]}
      ],
      "severity": "high"
