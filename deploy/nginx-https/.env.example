MCP_VAULT_IMAGE=mcp-vault:0.1.21
MCP_VAULT_PUBLIC_HOST=vault.example.com
MCP_VAULT_HTTP_PORT=80
MCP_VAULT_HTTPS_PORT=443

# Admin is a separate HTTPS listener bound only to this LAN address. The
# certificate must cover MCP_VAULT_ADMIN_HOST (it may equal PUBLIC_HOST).
MCP_VAULT_ADMIN_BIND_IP=192.168.1.20
MCP_VAULT_ADMIN_HOST=vault.example.com
MCP_VAULT_ADMIN_HTTPS_PORT=8444
MCP_VAULT_ADMIN_SOURCE_CIDR=192.168.1.0/24

# Change these together if the default private subnet conflicts with another
# Docker network. MCP_VAULT_PROXY_IP must remain one exact address in the subnet.
MCP_VAULT_PROXY_SUBNET=172.30.30.0/24
MCP_VAULT_PROXY_IP=172.30.30.10
MCP_VAULT_APP_IP=172.30.30.20
